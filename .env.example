# Culture Connect backend secrets — never commit this file.
QLOO_API_KEY=your_qloo_hackathon_key
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional LLM for the agentic planner (none | openai | anthropic | gemini). Leave as none to use the rule-based planner.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Qloo output categories used to find shared cultural anchors for each group
DISCOVERY_TYPES=urn:entity:book,urn:entity:podcast,urn:entity:movie,urn:entity:artist
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional: SQLite file location (defaults to data/culture_connect.db)
# DB_PATH=data/culture_connect.db
# Optional: uploaded photos (defaults to an 'uploads' folder next to the database) and max size in bytes
# UPLOAD_DIR=data/uploads
# UPLOAD_MAX_BYTES=3145728

# ---- Accounts & email (optional). Without SMTP, reset/verification links are printed to the server console.
APP_BASE_URL=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SESSION_DAYS=30
# Platform admins who review organisation verification (their email must be confirmed)
ADMIN_EMAILS=
# ---- Maps (optional): OpenStreetMap Nominatim address search; requires a contact email
GEOCODER=
NOMINATIM_EMAIL=
# ---- Autonomous agents (background job worker runs inside the app process)
AGENT_WORKER=1
AGENT_VOTE_HOURS=48
AGENT_MIN_CIRCLE=3
AGENT_SWEEP_SECONDS=30
